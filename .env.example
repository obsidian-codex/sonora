# ==============================================================================
# Sonora — Environment Variables Template
# Copy this file to .env.local and populate with your credentials.
# NOTE: .env.local is ignored by git and will never be committed.
# ==============================================================================

# Google Gemini API Key (Server-side critical analysis engine)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# Supabase (Optional - for user authentication and cloud library persistence)
# Safe in browser:
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Supabase Server-side only (NEVER expose to browser):
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# MusicBrainz User-Agent metadata (No API key required)
MUSICBRAINZ_APP_NAME="Sonora"
MUSICBRAINZ_APP_VERSION="1.0.0"
MUSICBRAINZ_APP_CONTACT="contact@sonora.app"
